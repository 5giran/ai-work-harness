{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:decision-view:v1",
  "title": "Read-only decision viewer export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_sha256",
    "generated_at",
    "include_cited_excerpts",
    "status",
    "artifacts",
    "digest_map",
    "cited_excerpts",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "decision-view.v1"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "include_cited_excerpts": {"type": "boolean"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_state",
        "verified",
        "decision_complete",
        "ready",
        "stale_reasons"
      ],
      "properties": {
        "lifecycle_state": {"type": "string", "minLength": 1},
        "verified": {"type": "boolean"},
        "decision_complete": {"type": "boolean"},
        "ready": {"type": "boolean"},
        "stale_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ref-key"},
      "additionalProperties": {"$ref": "#/$defs/artifact-envelope"}
    },
    "digest_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ref-key"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "cited_excerpts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/human-id"},
      "additionalProperties": {"type": "string"}
    },
    "integrity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"include_cited_excerpts": {"const": false}},
        "required": ["include_cited_excerpts"]
      },
      "then": {"properties": {"cited_excerpts": {"maxProperties": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref-key": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
    },
    "human-id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "artifact-envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "session_id",
        "producer",
        "parents",
        "payload"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "artifact_type": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"type": "string", "minLength": 1}}
        },
        "parents": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "payload": {"type": "object"}
      }
    }
  }
}
