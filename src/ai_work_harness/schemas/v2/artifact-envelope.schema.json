{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:artifact-envelope",
  "title": "Decision artifact envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "session_id",
    "producer",
    "parents",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"$ref": "#/$defs/safe-id"},
    "session_id": {"$ref": "#/$defs/safe-id"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"$ref": "#/$defs/ref-key"}
      }
    },
    "parents": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ref-key"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "payload": {"type": "object"}
  },
  "$defs": {
    "safe-id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "ref-key": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
