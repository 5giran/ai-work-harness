{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:payload:criteria-set",
  "title": "Criteria set payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["priority"],
        "properties": {"priority": {"const": "must"}}
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "title", "definition", "priority"],
        "properties": {
          "criterion_id": {"$ref": "#/$defs/id"},
          "title": {"$ref": "#/$defs/text"},
          "definition": {"$ref": "#/$defs/text"},
          "priority": {"enum": ["must", "high", "medium", "low"]}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "text": {"type": "string", "minLength": 1}
  }
}
