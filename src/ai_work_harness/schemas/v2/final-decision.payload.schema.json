{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:payload:final-decision",
  "title": "Human final decision payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "candidate_id",
    "reason",
    "risk_acknowledgements",
    "recommendation_relation",
    "recorded_at"
  ],
  "properties": {
    "disposition": {"enum": ["select", "reject_all", "defer", "request_more_evidence"]},
    "candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "reason": {"type": "string", "minLength": 1},
    "risk_acknowledgements": {"type": "array", "items": {"type": "string"}},
    "recommendation_relation": {"enum": ["same", "different", "no_recommendation"]},
    "recorded_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "select"}}},
      "then": {"properties": {"candidate_id": {"$ref": "#/$defs/id"}}},
      "else": {"properties": {"candidate_id": {"type": "null"}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
