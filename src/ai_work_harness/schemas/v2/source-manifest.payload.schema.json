{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:payload:source-manifest",
  "title": "Source manifest payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "media_type", "bytes", "blob_sha256"],
        "properties": {
          "source_id": {"$ref": "#/$defs/id"},
          "media_type": {"enum": ["text/plain", "text/markdown"]},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 10485760},
          "blob_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
