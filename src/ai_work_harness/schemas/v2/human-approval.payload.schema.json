{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:payload:human-approval",
  "title": "Human approval payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "challenge_id",
    "challenge_sha256",
    "decision_bundle_sha256",
    "disposition",
    "reason",
    "actor_label",
    "identity_verified",
    "approved_at"
  ],
  "properties": {
    "approval_id": {"$ref": "#/$defs/uuid4"},
    "challenge_id": {"$ref": "#/$defs/uuid4"},
    "challenge_sha256": {"$ref": "#/$defs/sha256"},
    "decision_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "disposition": {"enum": ["approved", "rejected", "changes_requested"]},
    "reason": {"type": "string", "minLength": 1},
    "actor_label": {"const": "local_operator"},
    "identity_verified": {"const": false},
    "approved_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
