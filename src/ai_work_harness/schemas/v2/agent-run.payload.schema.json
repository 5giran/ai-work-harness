{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-work-harness:schema:v2:payload:agent-run",
  "title": "Agent run trace payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "provider",
    "model",
    "operation",
    "prompt_id",
    "prompt_sha256",
    "input_sha256",
    "input_snapshot_sha256",
    "outbound_manifest_sha256",
    "transcript_sha256",
    "tool_name",
    "response_id",
    "usage",
    "result_sha256",
    "status",
    "error_code",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "run_id": {"$ref": "#/$defs/uuid4"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "operation": {"enum": ["evaluations", "recommendation"]},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "outbound_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "transcript_sha256": {"$ref": "#/$defs/sha256"},
    "tool_name": {"type": "string", "minLength": 1},
    "response_id": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "succeeded"},
    "error_code": {"type": "null"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "completed_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
